# Base de données PostgreSQL
DATABASE_URL="postgresql://gleba:gleba@localhost:5432/gleba?schema=public"
POSTGRES_USER=gleba
POSTGRES_PASSWORD=gleba
POSTGRES_DB=gleba

# NextAuth.js (authentification)
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Connexion Google (optionnel). Créer un client OAuth 2.0 "Application Web"
# dans Google Cloud Console avec comme URI de redirection autorisée :
#   <NEXTAUTH_URL>/api/auth/callback/google
# Laisser vide pour désactiver le bouton « Continuer avec Google ».
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin initial (pour seed-admin.ts)
ADMIN_EMAIL="admin@gleba.local"
ADMIN_PASSWORD="changeme"
ADMIN_NAME="Administrateur"

# Application
# NODE_ENV est forcé à "production" dans l'image Docker (Dockerfile).
# Mettre "development" uniquement pour `npm run dev` en local hors Docker.
NODE_ENV=production

# Email de notification feedback (laisser vide en self-host si vous lisez
# les retours via l'UI admin ; sinon mettre votre adresse de support)
FEEDBACK_EMAIL=

# SMTP (optionnel — pour envois feedback, reset password, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Notifications métier par email (résumé quotidien + alertes temps réel)
# NOTIF_ENABLED est l'interrupteur GÉNÉRAL du scheduler : il tourne dès que
# SMTP_HOST/SMTP_USER sont définis, et NOTIF_ENABLED=false le coupe entièrement.
# Côté utilisateur, en revanche, TOUT EST ÉTEINT PAR DÉFAUT (opt-in) : chacun
# active les types qu'il veut dans /parametres. Un scheduler actif n'envoie donc
# rien tant que personne n'a rien coché — c'est voulu, voir src/lib/notifications/prefs.ts.
NOTIF_ENABLED=true
# Heure du résumé quotidien « Quoi faire ce matin ? » (heure locale conteneur, TZ).
NOTIF_RESUME_HEURE=07:00
# Fréquence (minutes) du scan météo temps réel + alertes urgentes (borné 5-1440).
NOTIF_METEO_INTERVAL_MIN=30
# Notifications push navigateur — générer les clés : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com
# Test des scripts scripts/test-notif-*.ts depuis l'hôte (optionnel)
TEST_DATABASE_URL=

# Agents Paperclip des modes Normal, Extra et Support (clés privées côté serveur)
GLEBA_PAPERCLIP_API_URL=
GLEBA_PAPERCLIP_COMPANY_ID=
GLEBA_PAPERCLIP_NORMAL_AGENT_ID=
GLEBA_PAPERCLIP_NORMAL_AGENT_KEY=
GLEBA_PAPERCLIP_ADVANCED_AGENT_ID=
GLEBA_PAPERCLIP_ADVANCED_AGENT_KEY=
GLEBA_PAPERCLIP_SUPPORT_AGENT_ID=
GLEBA_PAPERCLIP_SUPPORT_AGENT_KEY=
GLEBA_PAPERCLIP_SUPPORT_TICKET_ASSIGNEE_ID=
# Cadence de sondage des issues Paperclip en ms (défaut : 1000)
GLEBA_PAPERCLIP_POLL_MS=
# Réponses directes sans LLM pour les lectures récurrentes ("off" pour désactiver)
GLEBA_REPONSES_DIRECTES=

# Banque : les clés restreintes de chaque compte sont saisies dans l'application.
# Clé de chiffrement stable (32 caractères minimum). Si vide, NEXTAUTH_SECRET
# est utilisé. Sa rotation impose de reconnecter les comptes Stripe.
STRIPE_TOKEN_ENCRYPTION_KEY=
# OAuth Stripe Connect Standard facultatif, sinon connexion par clé restreinte.
STRIPE_CONNECT_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_SYNC_ENABLED=true
